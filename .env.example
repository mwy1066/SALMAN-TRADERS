# Copy these names into local or hosting environment settings. Do not commit real keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set the real preferred HTTPS origin before building for deployment.
# No trailing path, credentials, query string or port. Leave blank for local work.
SITE_URL=
# Enable only on the production deployment after launch checks. Leave false on previews.
SITE_INDEXABLE=false

# Exact trusted app origin for Auth form posts and email callbacks.
# Use http://localhost:3000 locally, then the real HTTPS origin on your host.
AUTH_SITE_URL=http://localhost:3000
